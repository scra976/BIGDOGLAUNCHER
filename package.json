{
  "name": "bigdog-launcher",
  "version": "1.1.0",
  "description": "BIG DOG Launcher — install, play, and update games from GitHub.",
  "author": "BIG DOG",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:studio": "node scripts/dev-studio.mjs",
    "build": "vite build",
    "pack": "vite build && electron-builder --win nsis",
    "pack:studio": "vite build && electron-builder --config electron-builder.studio.yml --win nsis",
    "pack:dir": "vite build && electron-builder --win dir",
    "preview": "vite preview",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "extract-zip": "^2.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/extract-zip": "^2.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
